<mvc:View
  controllerName="com.alen.mm.wfaltamat.wizard.controller.WizardLaunchpad"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  displayBlock="true">
  <Page id="wlpPage" title="{i18n>wlpTitle}" showNavButton="true" navButtonPress=".onVolver" class="sapUiContentPadding">
    <content>
      <Title id="wlpTitleGroupMateriales" text="{i18n>wlpGroupMateriales}" level="H3" class="sapUiSmallMarginBottom"/>
      <HBox id="wlpHboxTiles" wrap="Wrap">
        <GenericTile
          id="wlpTileCrear"
          class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
          header="{i18n>wlpTileCrear}"
          subheader="{i18n>wlpTileCrearSub}"
          frameType="TwoByOne"
          headerImage="sap-icon://add-document"
          press=".onCrearMaterial"/>
        <GenericTile
          id="wlpTileExtender"
          class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
          header="{i18n>wlpTileExtender}"
          subheader="{i18n>wlpTileExtenderSub}"
          frameType="TwoByOne"
          headerImage="sap-icon://edit"
          press=".onExtenderMaterial"/>
      </HBox>
    </content>
  </Page>
</mvc:View>
