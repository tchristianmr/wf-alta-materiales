<mvc:View
  controllerName="com.alen.mm.wfaltamat.controller.DynamicPage"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.f"
  xmlns:form="sap.ui.layout.form"
  xmlns:core="sap.ui.core"
  displayBlock="true"
  height="100%">
  <f:DynamicPage id="dpPage" headerExpanded="false" toggleHeaderOnTitleClick="false" showFooter="true">
    <f:title>
      <f:DynamicPageTitle id="dpTitle">
        <f:heading>
          <Title id="dpHeading" text="{i18n>dpTitle}" level="H2"/>
        </f:heading>
        <f:content>
          <SegmentedButton
            id="dpSegModo"
            selectedKey="{/header/modoSolicitud}"
            enabled="{= ${/header/estadoProceso} === 'Captura' }"
            selectionChange=".onModoSolicitudChange">
            <items>
              <SegmentedButtonItem id="dpSegCreacion" key="creacion" text="{i18n>lblCreacion}"/>
              <SegmentedButtonItem id="dpSegExtension" key="extension" text="{i18n>lblExtension}"/>
            </items>
          </SegmentedButton>
        </f:content>
      </f:DynamicPageTitle>
    </f:title>

    <f:content>
      <VBox id="dpContentRoot">
        <MessageStrip
          id="dpMsgStrip"
          text="{/ui/messageStripText}"
          type="{/ui/messageStripType}"
          showIcon="true"
          showCloseButton="false"
          visible="{/ui/messageStripVisible}"
          class="sapUiSmallMarginBottom"/>

        <!-- Sección de Captura Activa -->
        <form:SimpleForm id="dpFormGenerales" editable="true" layout="ResponsiveGridLayout">
          <core:Title id="dpTitleGenerales" text="{i18n>stepDatosGenerales}"/>

          <Label id="dpLblMaterial" text="{i18n>lblMaterial}"/>
          <Input
            id="dpInpMaterial"
            value="{/header/material}"
            editable="{= ${/header/estadoProceso} === 'Captura' &amp;&amp; (${/header/modoSolicitud} === 'extension' || ${/ui/rangoNumeracion} !== 'Interno') }"
            placeholder="{= ${/ui/rangoNumeracion} === 'Interno' &amp;&amp; ${/header/modoSolicitud} === 'creacion' ? ${i18n>phMaterialInterno} : ${i18n>phMaterialNumero} }"
            change=".onMaterialChange"/>

          <Label id="dpLblTipoMaterial" text="{i18n>lblTipoMaterial}"/>
          <Input
            id="dpInpTipoMaterial"
            value="{/header/tipoMaterial}"
            description="{/header/tipoMaterialDesc}"
            fieldWidth="35%"
            showValueHelp="true"
            valueHelpRequest=".onAyudaBusqueda"
            showSuggestion="true"
            filterSuggests="false"
            suggest=".onSuggestFiltrar"
            suggestionRows="{valueHelp>/tiposMaterial}"
            suggestionItemSelected=".onAyudaSugerenciaSeleccionada"
            change=".onAyudaCambio"
            editable="{= ${/header/estadoProceso} === 'Captura' }">
            <customData><core:CustomData key="campo" value="tipoMaterial"/></customData>
            <suggestionColumns>
              <Column id="colTpMatCodigo" width="8rem"><header><Text id="txtTpMatCodigo" text="{i18n>vhColCodigo}"/></header></Column>
              <Column id="colTpMatDescripcion"><header><Text id="txtTpMatDescripcion" text="{i18n>vhColDescripcion}"/></header></Column>
            </suggestionColumns>
            <suggestionRows>
              <ColumnListItem id="colTpMatListItem"><cells><Label id="LblTpMatCodigo" text="{valueHelp>key}"/><Label id="LblTpMatDescripcion" text="{valueHelp>text}"/></cells></ColumnListItem>
            </suggestionRows>
          </Input>

          <Label id="dpLblRamo" text="{i18n>lblRamo}"/>
          <Input
            id="dpInpRamo"
            value="{/header/ramo}"
            description="{/header/ramoDesc}"
            fieldWidth="35%"
            showValueHelp="true"
            valueHelpRequest=".onAyudaBusqueda"
            showSuggestion="true"
            filterSuggests="false"
            suggest=".onSuggestFiltrar"
            suggestionRows="{valueHelp>/ramos}"
            suggestionItemSelected=".onAyudaSugerenciaSeleccionada"
            change=".onAyudaCambio"
            editable="{= ${/header/estadoProceso} === 'Captura' }">
            <customData><core:CustomData key="campo" value="ramo"/></customData>
            <suggestionColumns>
              <Column id="colRamoCodigo" width="8rem"><header><Text id="txtRamoCodigo" text="{i18n>vhColCodigo}"/></header></Column>
              <Column id="colRamoDescripcion"><header><Text id="txtRamoDescripcion" text="{i18n>vhColDescripcion}"/></header></Column>
            </suggestionColumns>
            <suggestionRows>
              <ColumnListItem id="colRamoListItem"><cells><Label id="LblRamoCodigo" text="{valueHelp>key}"/><Label id="LblRamoDescripcion" text="{valueHelp>text}"/></cells></ColumnListItem>
            </suggestionRows>
          </Input>

          <Label id="dpLblTipoEntrada" text="{i18n>lblTipoEntrada}"/>
          <Input
            id="dpInpTipoEntrada"
            value="{/header/tipoEntrada}"
            description="{/header/tipoEntradaDesc}"
            fieldWidth="35%"
            showValueHelp="true"
            valueHelpRequest=".onAyudaBusqueda"
            showSuggestion="true"
            filterSuggests="false"
            suggest=".onSuggestFiltrar"
            suggestionRows="{valueHelp>/tiposEntrada}"
            suggestionItemSelected=".onAyudaSugerenciaSeleccionada"
            change=".onAyudaCambio"
            editable="{= ${/header/estadoProceso} === 'Captura' }">
            <customData><core:CustomData key="campo" value="tipoEntrada"/></customData>
            <suggestionColumns>
              <Column id="colTipoEntradaCodigo" width="8rem"><header><Text id="txtTipoEntradaCodigo" text="{i18n>vhColCodigo}"/></header></Column>
              <Column id="colTipoEntradaDescripcion"><header><Text id="txtTipoEntradaDescripcion" text="{i18n>vhColDescripcion}"/></header></Column>
            </suggestionColumns>
            <suggestionRows>
              <ColumnListItem id="colTipoEntradaListItem"><cells><Label id="LblTipoEntradaCodigo" text="{valueHelp>key}"/><Label id="LblTipoEntradaDescripcion" text="{valueHelp>text}"/></cells></ColumnListItem>
            </suggestionRows>
          </Input>
          
          <Label id="dpLblCentro" text="{i18n>lblCentro}"/>
          <Input
            id="dpInpCentro"
            value="{/header/centro}"
            description="{/header/centroDesc}"
            fieldWidth="35%"
            showValueHelp="true"
            valueHelpRequest=".onAyudaBusqueda"
            showSuggestion="true"
            filterSuggests="false"
            suggest=".onSuggestFiltrar"
            suggestionRows="{valueHelp>/centros}"
            suggestionItemSelected=".onAyudaSugerenciaSeleccionada"
            change=".onAyudaCambio"
            editable="{= ${/header/estadoProceso} === 'Captura' }">
            <customData><core:CustomData key="campo" value="centro"/></customData>
            <suggestionColumns>
              <Column id="colCentroCodigo" width="8rem"><header><Text id="txtCentroCodigo" text="{i18n>vhColCodigo}"/></header></Column>
              <Column id="colCentroDescripcion"><header><Text id="txtCentroDescripcion" text="{i18n>vhColDescripcion}"/></header></Column>
            </suggestionColumns>
            <suggestionRows>
              <ColumnListItem id="colCentroListItem"><cells><Label id="LblCentroCodigo" text="{valueHelp>key}"/><Label id="LblCentroDescripcion" text="{valueHelp>text}"/></cells></ColumnListItem>
            </suggestionRows>
          </Input>

          <Label id="dpLblOrgVentas" text="{i18n>lblOrgVentas}"/>
          <Input
            id="dpInpOrgVentas"
            value="{/header/orgVentas}"
            description="{/header/orgVentasDesc}"
            fieldWidth="35%"
            placeholder="{i18n>phOrgVentas}"
            showValueHelp="true"
            valueHelpRequest=".onAyudaBusqueda"
            showSuggestion="true"
            filterSuggests="false"
            suggest=".onSuggestFiltrar"
            suggestionRows="{valueHelp>/orgVentas}"
            suggestionItemSelected=".onAyudaSugerenciaSeleccionada"
            change=".onAyudaCambio"
            editable="{= ${/header/estadoProceso} === 'Captura' }">
            <customData><core:CustomData key="campo" value="orgVentas"/></customData>
            <suggestionColumns>
              <Column id="colOrgVentasCodigo" width="8rem"><header><Text id="txtOrgVentasCodigo" text="{i18n>vhColCodigo}"/></header></Column>
              <Column id="colOrgVentasDescripcion"><header><Text id="txtOrgVentasDescripcion" text="{i18n>vhColDescripcion}"/></header></Column>
            </suggestionColumns>
            <suggestionRows>
              <ColumnListItem id="colOrgVentasListItem"><cells><Label id="LblOrgVentasCodigo" text="{valueHelp>key}"/><Label id="LblOrgVentasDescripcion" text="{valueHelp>text}"/></cells></ColumnListItem>
            </suggestionRows>
          </Input>

          <Label id="dpLblMaquilado" text="{i18n>lblMaterialMaquilado}"/>
          <CheckBox id="dpCbMaquilado" selected="{/header/materialMaquilado}" enabled="{= ${/header/estadoProceso} === 'Captura' }"/>

          <Label id="dpLblExportacion" text="{i18n>lblMaterialExportacion}"/>
          <CheckBox id="dpCbExportacion" selected="{/header/materialExportacion}" enabled="{= ${/header/estadoProceso} === 'Captura' }"/>

          <Label id="dpLblModoProceso" text="{i18n>lblModoProceso}"/>
          <RadioButtonGroup
            id="dpRbgModoProceso"
            columns="2"
            selectedIndex="{= ${/header/modoProceso} === 'M' ? 0 : 1 }"
            editable="{= ${/header/estadoProceso} === 'Captura' }"
            select=".onModoProcesoChange">
            <RadioButton id="dpRbFabricacion" text="{i18n>lblFabricacion}"/>
            <RadioButton id="dpRbDistribucion" text="{i18n>lblDistribucion}"/>
          </RadioButtonGroup>

          <core:Title id="dpTitleBasicos" text="{i18n>stepDatosBasicos}"/>

          <Label id="dpLblDenomEs" text="{i18n>lblDenominacionEs}"/>
          <Input
            id="dpInpDenomEs"
            value="{/header/descripcionEs}"
            editable="{= ${/header/modoSolicitud} !== 'extension' &amp;&amp; ${/header/estadoProceso} === 'Captura' }"
            change=".onDenominacionChange"/>

          <Label id="dpLblUmBase" text="{i18n>lblUmBase}"/>
          <Input
            id="dpInpUmBase"
            value="{/header/umBase}"
            description="{/header/umBaseDesc}"
            fieldWidth="35%"
            showValueHelp="true"
            valueHelpRequest=".onAyudaBusqueda"
            showSuggestion="true"
            filterSuggests="false"
            suggest=".onSuggestFiltrar"
            suggestionRows="{valueHelp>/unidades}"
            suggestionItemSelected=".onAyudaSugerenciaSeleccionada"
            change=".onAyudaCambio"
            editable="{= ${/header/modoSolicitud} !== 'extension' &amp;&amp; ${/header/estadoProceso} === 'Captura' }">
            <customData><core:CustomData key="campo" value="umBase"/></customData>
            <suggestionColumns>
              <Column id="colUmBaseCodigo" width="8rem"><header><Text id="txtUmBaseCodigo" text="{i18n>vhColCodigo}"/></header></Column>
              <Column id="colUmBaseDescripcion"><header><Text id="txtUmBaseDescripcion" text="{i18n>vhColDescripcion}"/></header></Column>
            </suggestionColumns>
            <suggestionRows>
              <ColumnListItem id="colUmBaseListItem"><cells><Label id="LblUmBaseCodigo" text="{valueHelp>key}"/><Label id="LblUmBaseDescripcion" text="{valueHelp>text}"/></cells></ColumnListItem>
            </suggestionRows>
          </Input>

          <Label id="dpLblSector" text="{i18n>lblSector}"/>
          <Input
            id="dpInpSector"
            value="{/header/sector}"
            description="{/header/sectorDesc}"
            fieldWidth="35%"
            showValueHelp="true"
            valueHelpRequest=".onAyudaBusqueda"
            showSuggestion="true"
            filterSuggests="false"
            suggest=".onSuggestFiltrar"
            suggestionRows="{valueHelp>/sectores}"
            suggestionItemSelected=".onAyudaSugerenciaSeleccionada"
            change=".onAyudaCambio"
            editable="{= ${/header/modoSolicitud} !== 'extension' &amp;&amp; ${/header/estadoProceso} === 'Captura' }">
            <customData><core:CustomData key="campo" value="sector"/></customData>
            <suggestionColumns>
              <Column id="colSectorCodigo" width="8rem"><header><Text id="txtSectorCodigo" text="{i18n>vhColCodigo}"/></header></Column>
              <Column id="colSectorDescripcion"><header><Text id="txtSectorDescripcion" text="{i18n>vhColDescripcion}"/></header></Column>
            </suggestionColumns>
            <suggestionRows>
              <ColumnListItem id="colSectorListItem"><cells><Label id="LblSectorCodigo" text="{valueHelp>key}"/><Label id="LblSectorDescripcion" text="{valueHelp>text}"/></cells></ColumnListItem>
            </suggestionRows>
          </Input>

          <Label id="dpLblGrupoTipoPosGral" text="{i18n>lblGrupoTipoPosGral}"/>
          <Input
            id="dpInpGrupoTipoPosGral"
            value="{/header/grupoTipoPosGral}"
            description="{/header/grupoTipoPosGralDesc}"
            fieldWidth="35%"
            showValueHelp="true"
            valueHelpRequest=".onAyudaBusqueda"
            showSuggestion="true"
            filterSuggests="false"
            suggest=".onSuggestFiltrar"
            suggestionRows="{valueHelp>/gruposTipoPosGral}"
            suggestionItemSelected=".onAyudaSugerenciaSeleccionada"
            change=".onAyudaCambio"
            editable="{= ${/header/modoSolicitud} !== 'extension' &amp;&amp; ${/header/estadoProceso} === 'Captura' }">
            <customData><core:CustomData key="campo" value="grupoTipoPosGral"/></customData>
            <suggestionColumns>
              <Column id="colGrupoTipoPosGralCodigo" width="8rem"><header><Text id="txtGrupoTipoPosGralCodigo" text="{i18n>vhColCodigo}"/></header></Column>
              <Column id="colGrupoTipoPosGralDescripcion"><header><Text id="txtGrupoTipoPosGralDescripcion" text="{i18n>vhColDescripcion}"/></header></Column>
            </suggestionColumns>
            <suggestionRows>
              <ColumnListItem id="colGrupoTipoPosGralListItem"><cells><Label id="LblGrupoTipoPosGralCodigo" text="{valueHelp>key}"/><Label id="LblGrupoTipoPosGralDescripcion" text="{valueHelp>text}"/></cells></ColumnListItem>
            </suggestionRows>
          </Input>

          <Label id="dpLblGrupoArticulos" text="{i18n>lblGrupoArticulos}"/>
          <Input
            id="dpInpGrupoArticulos"
            value="{/header/grupoArticulos}"
            description="{/header/grupoArticulosDesc}"
            fieldWidth="35%"
            showValueHelp="true"
            valueHelpRequest=".onAyudaBusqueda"
            showSuggestion="true"
            filterSuggests="false"
            suggest=".onSuggestFiltrar"
            suggestionRows="{valueHelp>/gruposArticulos}"
            suggestionItemSelected=".onAyudaSugerenciaSeleccionada"
            change=".onAyudaCambio"
            editable="{= ${/header/modoSolicitud} !== 'extension' &amp;&amp; ${/header/estadoProceso} === 'Captura' }">
            <customData><core:CustomData key="campo" value="grupoArticulos"/></customData>
            <suggestionColumns>
              <Column id="colGrupoArticulosCodigo" width="8rem"><header><Text id="txtGrupoArticulosCodigo" text="{i18n>vhColCodigo}"/></header></Column>
              <Column id="colGrupoArticulosDescripcion"><header><Text id="txtGrupoArticulosDescripcion" text="{i18n>vhColDescripcion}"/></header></Column>
            </suggestionColumns>
            <suggestionRows>
              <ColumnListItem id="colGrupoArticulosListItem"><cells><Label id="LblGrupoArticulosCodigo" text="{valueHelp>key}"/><Label id="LblGrupoArticulosDescripcion" text="{valueHelp>text}"/></cells></ColumnListItem>
            </suggestionRows>
          </Input>

          <Label id="dpLblJerarquia" text="{i18n>lblJerarquiaProductos}"/>
          <Input
            id="dpInpJerarquia"
            value="{/header/jerarquiaProductos}"
            editable="{= ${/header/modoSolicitud} !== 'extension' &amp;&amp; ${/header/estadoProceso} === 'Captura' }"
            placeholder="{= ${/header/tipoMaterial} === 'FERT' ? ${i18n>phJerarquiaFert} : '' }"
            change=".onDatosBasicosChange"/>
        </form:SimpleForm>        

        <IconTabBar id="dpTabsVistas" expandable="false" visible="{= ${/header/estadoProceso} !== 'Captura' }" class="sapUiResponsiveContentPadding">
          <items>
            <IconTabFilter id="dpTabVistasACrear" text="{i18n>tabVistasACrear}" key="crear" count="{= ${/vistasCrear}.length }">
              <Table id="dpTblVistasACrear" items="{/vistasCrear}" mode="None" noDataText="{i18n>noDataVistasACrear}">
                <columns>
                  <Column id="dpColSec" width="4rem"><Text id="dpTxtColSec" text="{i18n>colSecuencia}"/></Column>
                  <Column id="dpColVista"><Text id="dpTxtColVista" text="{i18n>colVista}"/></Column>
                  <Column id="dpColDescVista"><Text id="dpTxtColDescVista" text="{i18n>colDescripcionVista}"/></Column>
                  <Column id="dpColUsuario"><Text id="dpTxtColUsuario" text="{i18n>colUsuario}"/></Column>
                  <Column id="dpColChkCrear" hAlign="Center" width="4rem"><Text id="dpTxtColChk" text="{i18n>colCrear}"/></Column>
                  <Column id="dpColSemCreada" hAlign="Center"><Text id="dpTxtColSemCreada" text="{i18n>colCreada}"/></Column>
                  <Column id="dpColSemEnWF" hAlign="Center"><Text id="dpTxtColSemEnWF" text="{i18n>colEnWF}"/></Column>
                </columns>
                <items>
                  <ColumnListItem id="dpCliVista">
                    <cells>
                      <Text id="dpTxtSec" text="{= ${secuencia} === 99 ? '—' : ${secuencia} }"/>
                      <Text id="dpTxtVista" text="{vista}"/>
                      <Text id="dpTxtDescVista" text="{descripcionVista}"/>
                      <Text id="dpTxtUsuario" text="{usuarioResponsable}"/>
                      <CheckBox id="dpChkVistaCrear" selected="{crear}" enabled="{= !${creada} &amp;&amp; !${enWF} &amp;&amp; ${/header/estadoProceso} === 'Confirmado' }" select=".onVistaSelect"/>
                      <core:Icon id="dpIconCreada" src="{path:'creada', formatter:'.formatter.semaforoIcon'}" color="{= ${creada} ? '#107E3E' : '#BB0000' }"/>
                      <core:Icon id="dpIconEnWF" src="{path:'enWF', formatter:'.formatter.semaforoIcon'}" color="{= ${enWF} ? '#107E3E' : '#BB0000' }"/>
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </IconTabFilter>

            <IconTabFilter id="dpTabVistasCreadas" text="{i18n>tabVistasCreadas}" key="creadas" count="{path:'/vistasCrear', formatter:'.formatter.contarCreadas'}">
              <Table id="dpTblVistasCreadas" items="{path:'/vistasCrear', filters:[{path:'creada',operator:'EQ',value1:true}]}" mode="None" noDataText="{i18n>noDataVistasCreadas}">
                <columns>
                  <Column id="dpColCreadasVista"><Text id="dpTxtColCreadasVista" text="{i18n>colVista}"/></Column>
                  <Column id="dpColCreadasDesc"><Text id="dpTxtColCreadasDesc" text="{i18n>colDescripcionVista}"/></Column>
                </columns>
                <items>
                  <ColumnListItem id="dpCliCreadas">
                    <cells>
                      <Text id="dpTxtCreadasVista" text="{vista}"/>
                      <Text id="dpTxtCreadasDesc" text="{descripcionVista}"/>
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </IconTabFilter>

            <IconTabFilter id="dpTabVistasEnWF" text="{i18n>tabVistasEnWF}" key="enwf" count="{path:'/vistasCrear', formatter:'.formatter.contarEnWF'}">
              <Table id="dpTblVistasEnWF" items="{path:'/vistasCrear', filters:[{path:'enWF',operator:'EQ',value1:true}]}" mode="None" noDataText="{i18n>noDataVistasEnWF}">
                <columns>
                  <Column id="dpColEnWFTitulo"><Text id="dpTxtColEnWFTitulo" text="{i18n>colTitulo}"/></Column>
                  <Column id="dpColEnWFFecha"><Text id="dpTxtColEnWFFecha" text="{i18n>colFechaCreacion}"/></Column>
                  <Column id="dpColEnWFUsuario"><Text id="dpTxtColEnWFUsuario" text="{i18n>colUsuario}"/></Column>
                </columns>
                <items>
                  <ColumnListItem id="dpCliEnWF">
                    <cells>
                      <Text id="dpTxtEnWFTitulo" text="{wiTitulo}"/>
                      <Text id="dpTxtEnWFFecha" text="{wiFechaCreacion}"/>
                      <Text id="dpTxtEnWFUsuario" text="{wiUsuario}"/>
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </IconTabFilter>

            <IconTabFilter id="dpTabVistasVenta" text="{i18n>tabVistasDeVentas}" key="ventas" count="{= ${/vistasVenta}.length }">
              <Table id="dpTblVistasVenta" items="{/vistasVenta}" mode="None" noDataText="{i18n>noDataVistasVenta}">
                <columns>
                  <Column id="dpColVentaMaterial"><Text id="dpTxtColVentaMaterial" text="{i18n>colMaterial}"/></Column>
                  <Column id="dpColVentaOrg"><Text id="dpTxtColVentaOrg" text="{i18n>colOrgVenta}"/></Column>
                  <Column id="dpColVentaCanal"><Text id="dpTxtColVentaCanal" text="{i18n>colCanalDist}"/></Column>
                </columns>
                <items>
                  <ColumnListItem id="dpCliVenta">
                    <cells>
                      <Text id="dpTxtVentaMaterial" text="{material}"/>
                      <Text id="dpTxtVentaOrg" text="{orgVentas}"/>
                      <Text id="dpTxtVentaCanal" text="{canalDistribucion}"/>
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </IconTabFilter>

            <IconTabFilter id="dpTabCanalesConf" text="{i18n>tabCanalesDistConf}" key="canales" count="{= ${/canalesConf}.length }">
              <Table id="dpTblCanalesConf" items="{/canalesConf}" mode="None" noDataText="{i18n>noDataCanales}">
                <columns>
                  <Column id="dpColCanalConfOrg"><Text id="dpTxtColCanalConfOrg" text="{i18n>colOrgVenta}"/></Column>
                  <Column id="dpColCanalConf"><Text id="dpTxtColCanalConf" text="{i18n>colCanalDist}"/></Column>
                </columns>
                <items>
                  <ColumnListItem id="dpCliCanalConf">
                    <cells>
                      <Text id="dpTxtCanalConfOrg" text="{orgVentas}"/>
                      <Text id="dpTxtCanalConf" text="{canalDistribucion}"/>
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </IconTabFilter>
          </items>
        </IconTabBar>

        <!-- Barra de Acciones Intermedia -->
        <OverflowToolbar id="dpToolbarIntermedia" class="sapUiSmallMarginTop sapUiSmallMarginBottom">
          <ToolbarSpacer id="dpToolbarIntermediaSpacer"/>
          <Button
            id="dpBtnLimpiar"
            text="{i18n>btnLimpiar}"
            type="Transparent"
            visible="{= ${/header/estadoProceso} === 'Captura' }"
            press=".onLimpiar"/>
          <Button
            id="dpBtnConfirmarDatos"
            text="{i18n>btnConfirmarDatos}"
            type="Emphasized"
            visible="{= ${/header/estadoProceso} === 'Captura' }"
            enabled="{/ui/formValidated}"
            press=".onConfirmarDatos"/>
          <Button
            id="dpBtnModificarDatos"
            text="{i18n>btnModificarDatos}"
            type="Default"
            visible="{= ${/header/estadoProceso} === 'Confirmado' }"
            press=".onModificarDatos"/>
          <Button
            id="dpBtnAgregarListado"
            text="{i18n>btnAgregarListado}"
            type="Emphasized"
            visible="{= ${/header/estadoProceso} === 'Confirmado' }"
            press=".onAgregarAlListado"/>
        </OverflowToolbar>

        <!-- Sección de Staging Grid -->
        <Panel id="dpPanelGrid" headerText="{i18n>titleGrid}" expandable="false">
          <Table
            id="dpGridSolicitudes"
            items="{/grid}"
            mode="None"
            noDataText="{i18n>noDataGrid}">
            <columns>
              <Column id="dpColGridMaterial" minScreenWidth="Tablet" demandPopin="true"><Text id="dpTxtGridMaterial" text="{i18n>colMaterial}"/></Column>
              <Column id="dpColGridDesc" minScreenWidth="Tablet" demandPopin="true"><Text id="dpTxtGridDesc" text="{i18n>colDescripcion}"/></Column>
              <Column id="dpColGridCentro"><Text id="dpTxtGridCentro" text="{i18n>colCentro}"/></Column>
              <Column id="dpColGridMatMaq" hAlign="Center" minScreenWidth="Desktop" demandPopin="true"><Text id="dpTxtGridMatMaq" text="{i18n>colMatMaq}"/></Column>
              <Column id="dpColGridCLt" hAlign="Center" minScreenWidth="Desktop" demandPopin="true"><Text id="dpTxtGridCLt" text="{i18n>colCLt}"/></Column>
              <Column id="dpColGridTipoFabDis" minScreenWidth="Desktop" demandPopin="true"><Text id="dpTxtGridTipoFabDis" text="{i18n>colTipoFabDis}"/></Column>
              <Column id="dpColGridRamo" minScreenWidth="Desktop" demandPopin="true"><Text id="dpTxtGridRamo" text="{i18n>colRamo}"/></Column>
              <Column id="dpColGridUm" minScreenWidth="Desktop" demandPopin="true"><Text id="dpTxtGridUm" text="{i18n>colUnidMed}"/></Column>
              <Column id="dpColGridSector" minScreenWidth="Desktop" demandPopin="true"><Text id="dpTxtGridSector" text="{i18n>colSector}"/></Column>
              <Column id="dpColGridGrTpPosGral" minScreenWidth="Desktop" demandPopin="true"><Text id="dpTxtGridGrTpPosGral" text="{i18n>colGrTpPosGral}"/></Column>
              <Column id="dpColGridGpoArt" minScreenWidth="Desktop" demandPopin="true"><Text id="dpTxtGridGpoArt" text="{i18n>colGpoArt}"/></Column>
              <Column id="dpColGridOrgVentas" minScreenWidth="Desktop" demandPopin="true"><Text id="dpTxtGridOrgVentas" text="{i18n>colOrgVentasGrid}"/></Column>
              <Column id="dpColGridJquiaProd" minScreenWidth="Desktop" demandPopin="true"><Text id="dpTxtGridJquiaProd" text="{i18n>colJquiaProd}"/></Column>
              <Column id="dpColGridVistas"><Text id="dpTxtGridVistas" text="{i18n>colVistasACrear}"/></Column>
              <Column id="dpColGridEstado" minScreenWidth="Tablet" demandPopin="true"><Text id="dpTxtGridEstado" text="{i18n>colEstado}"/></Column>
              <Column id="dpColGridMensaje" minScreenWidth="Desktop" demandPopin="true"><Text id="dpTxtGridMensaje" text="{i18n>colMensaje}"/></Column>
              <Column id="dpColGridAcciones" hAlign="Center"><Text id="dpTxtGridAcciones" text=""/></Column>
            </columns>
            <items>
              <ColumnListItem id="dpCliGrid">
                <cells>
                  <Text id="dpTxtCellMaterial" text="{material}"/>
                  <Text id="dpTxtCellDesc" text="{descripcion}"/>
                  <Text id="dpTxtCellCentro" text="{centro}"/>
                  <core:Icon id="dpIconCellMatMaq" src="{= ${materialMaquilado} ? 'sap-icon://accept' : 'sap-icon://less'}"/>
                  <core:Icon id="dpIconCellCLt" src="{= ${conListaMateriales} ? 'sap-icon://accept' : 'sap-icon://less'}"/>
                  <Text id="dpTxtCellTipoFabDis" text="{= ${modoProceso} === 'M' ? ${i18n>lblFabricacion} : ${i18n>lblDistribucion} }"/>
                  <Text id="dpTxtCellRamo" text="{ramo}"/>
                  <Text id="dpTxtCellUm" text="{umBase}"/>
                  <Text id="dpTxtCellSector" text="{sector}"/>
                  <Text id="dpTxtCellGrTpPosGral" text="{grupoTipoPosGral}"/>
                  <Text id="dpTxtCellGpoArt" text="{grupoArticulos}"/>
                  <Text id="dpTxtCellOrgVentas" text="{orgVentas}"/>
                  <Text id="dpTxtCellJquiaProd" text="{jerarquiaProductos}"/>
                  <Text id="dpTxtCellVistas" text="{vistasACrear}"/>
                  <ObjectStatus id="dpStatusCellEstado"
                                text="{= ${estado} === 'S' ? ${i18n>estadoEnviado} : ${estado} === 'W' ? ${i18n>estadoParcial} : ${estado} === 'E' ? ${i18n>estadoError} : ${i18n>estadoPendiente} }"
                                state="{= ${estado} === 'S' ? 'Success' : ${estado} === 'W' ? 'Warning' : ${estado} === 'E' ? 'Error' : 'None' }"/>
                  <Text id="dpTxtCellMensaje" text="{mensaje}"/>
                  <Button id="dpBtnStEliminarFila" icon="sap-icon://delete" type="Transparent" enabled="{= ${estado} === 'pendiente' || ${estado} === 'E' }" press=".onEliminarGridRow"/>
                  <Button id="dpBtnEliminarFila" icon="sap-icon://delete" type="Transparent" press=".onEliminarGridRow"/>
                </cells>
              </ColumnListItem>
            </items>
          </Table>
        </Panel>
      </VBox>
    </f:content>

    <f:footer>
      <OverflowToolbar id="dpFooter">
        <ToolbarSpacer id="dpFooterSpacer"/>
        <Button id="dpBtnCancelar" text="{i18n>dpBtnCancelar}" type="Reject" press=".onCancelar"/>
        <Button id="dpBtnEnviarWorkflow" text="{i18n>btnEnviarWorkflow}" type="Accept" icon="sap-icon://workflow-tasks" enabled="{/ui/hayRegistrosEnGrid}" press=".onEnviarWorkflow"/>
      </OverflowToolbar>
    </f:footer>
  </f:DynamicPage>
</mvc:View>