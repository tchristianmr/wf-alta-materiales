<mvc:View
  controllerName="com.alen.mm.wfaltamat.controller.Launchpad"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  displayBlock="true">
  <Page id="lpPageLaunchpad" title="{i18n>lpTitle}" showNavButton="false" class="sapUiContentPadding">
    <content>
      <Title id="lpTitleGroupMateriales" text="{i18n>lpGroupMateriales}" level="H3" class="sapUiSmallMarginBottom"/>
      <HBox id="lpHboxTiles" wrap="Wrap">
        <GenericTile
          id="lpTileProto1"
          class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
          header="{i18n>lpTileProto1}"
          subheader="{i18n>lpTileProto1Sub}"
          frameType="TwoByOne"
          headerImage="sap-icon://wrench"
          press=".onAbrirPrototipo1"/>
        <GenericTile
          id="lpTileProto2"
          class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
          header="{i18n>lpTileProto2}"
          subheader="{i18n>lpTileProto2Sub}"
          frameType="TwoByOne"
          headerImage="sap-icon://columns"
          press=".onAbrirPrototipo2"/>
        <GenericTile
          id="lpTileProto3"
          class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
          header="{i18n>lpTileProto3}"
          subheader="{i18n>lpTileProto3Sub}"
          frameType="TwoByOne"
          headerImage="sap-icon://list"
          press=".onAbrirPrototipo3"/>
      </HBox>
    </content>
  </Page>
</mvc:View>
